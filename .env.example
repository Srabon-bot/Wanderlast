# Public base URL of the deployed frontend (optional for previews).
# Example: https://wonderlast.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the Wonderlast API. Required in production.
# Example: https://wonderlast-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only API base URL override (optional).
API_URL=http://localhost:8000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API.
BETTER_AUTH_TRUSTED_ORIGINS=

# MongoDB Atlas connection string used by Better Auth.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Database name that stores Better Auth collections.
MONGODB_DB=wonderlust
